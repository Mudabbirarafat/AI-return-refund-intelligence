# Mumzworld Returns Intelligence — environment config
# Copy this file to .env and fill in your values.

# Required: OpenRouter API key
# Free signup at https://openrouter.ai
# The free tier includes qwen/qwen3-8b (our default model)
OPENROUTER_API_KEY=your-openrouter-api-key


# Optional: override the default model
# Default: qwen/qwen3-8b (free, strong Arabic + English)
# Alternatives: meta-llama/llama-3.3-70b-instruct:free  |  deepseek/deepseek-chat:free
# MODEL=qwen/qwen3-8b
